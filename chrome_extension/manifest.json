{
    "manifest_version": 3,
    "name": "Group 14 - Insert very cool and awesome name here guys",
    "version": "1.0.0",
    "description": "Locally detects and protects personally identifiable information using pattern-recognition techniques and BERT",
    "host_permissions": [
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://www.perplexity.ai/*",
        "https://gemini.google.com/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
    {
        "matches": ["https://chatgpt.com/*", "https://claude.ai/*"],
        "js": ["lib/detector.js"],
        "css": ["styles/highlight.css"]
    }
    ]
}

